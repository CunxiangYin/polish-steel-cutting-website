# Netlify redirects configuration

# Redirect old URLs to new structure
/index-lite.html    /    301
/index-full.html    /    301
/index-simple.html  /    301

# Language-specific redirects
/zh/*    /local-seo-optimization.html    200
/cn/*    /local-seo-optimization.html    200

# PWA support
/offline    /index.html    200

# 404 handling
/*    /404.html    404
